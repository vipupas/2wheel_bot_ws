<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="branching_corridor">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Main Corridor Wall (Right) -->
    <model name="wall_right">
      <pose>5 -2 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>12 0.2 1</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <!-- End Caps -->
    <model name="wall_start">
      <pose>-1 0 0.5 0 0 1.5708</pose>
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>4.2 0.2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>4.2 0.2 1</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_end">
      <pose>11 0 0.5 0 0 1.5708</pose>
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>4.2 0.2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>4.2 0.2 1</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Branching Corridor Walls -->
    <model name="branch_wall_1">
      <pose>5 4 0.5 0 0 1.5708</pose>
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>4 0.2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>4 0.2 1</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="branch_wall_2">
      <pose>7 4 0.5 0 0 1.5708</pose>
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>4 0.2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>4 0.2 1</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="branch_end">
      <pose>6 6 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>2.2 0.2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.2 0.2 1</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Opening in Left Wall for Branch (Split into two segments) -->
    <model name="wall_left_1">
      <pose>2 2 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>6 0.2 1</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_left_2">
      <pose>9 2 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>4 0.2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>4 0.2 1</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>